# GitHub Issue #31 - gen-class static method signature metadata
> https://github.com/oakmac/standard-clojure-style-js/issues/31

--Input
(ns foo
 (:gen-class
 :methods [ ^{:static true} [create [] Object]
 [instanceMethod [String] String] ]))
--Input

--Expected
(ns foo
  (:gen-class
   :methods [^{:static true} [create [] Object]
             [instanceMethod [String] String]]))
--Expected

# GitHub Issue #31 - gen-class constructor annotations
> https://github.com/oakmac/standard-clojure-style-js/issues/31

--Input
(ns foo
 (:gen-class
 :constructors { ^{Deprecated {}} [String] []
 [long] [] }
 :init init))
--Input

--Expected
(ns foo
  (:gen-class
   :init init
   :constructors {^{Deprecated {}} [String] []
                  [long] []}))
--Expected

# GitHub Issue #31 - gen-class class annotations
> https://github.com/oakmac/standard-clojure-style-js/issues/31

--Input
(ns foo
 (:gen-class
 :main true
 :name ^{Deprecated {}} example.Widget))
--Input

--Expected
(ns foo
  (:gen-class
   :name ^{Deprecated {}} example.Widget
   :main true))
--Expected

# GitHub Issue #31 - gen-class names supplied as strings
> https://github.com/oakmac/standard-clojure-style-js/issues/31

--Input
(ns foo
 (:gen-class
 :load-impl-ns false
 :impl-ns "example.widget-impl"
 :prefix "native-"
 :exposes-methods { close "callSuperClose" }
 :exposes { "in" { :set "setIn", :get "getIn" } }
 :state "state"
 :factory "create"
 :methods [ [ "transform", [ "java.lang.String" ], "java.lang.Object" ] ]
 :post-init "postInit"
 :constructors { [ "java.io.InputStream" ] [ "java.io.InputStream" ] }
 :init "init"
 :implements [ "java.lang.Runnable" ]
 :extends "java.io.FilterInputStream"
 :name "example.Widget"))
--Input

--Expected
(ns foo
  (:gen-class
   :name "example.Widget"
   :extends "java.io.FilterInputStream"
   :implements ["java.lang.Runnable"]
   :init "init"
   :constructors {["java.io.InputStream"] ["java.io.InputStream"]}
   :post-init "postInit"
   :methods [["transform" ["java.lang.String"] "java.lang.Object"]]
   :factory "create"
   :state "state"
   :exposes {"in" {:get "getIn" :set "setIn"}}
   :exposes-methods {close "callSuperClose"}
   :prefix "native-"
   :impl-ns "example.widget-impl"
   :load-impl-ns false))
--Expected
